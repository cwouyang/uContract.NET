<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>uContract.AotSmoke</AssemblyName>
    <RootNamespace>uContract.AotSmoke</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IL2026: the program deliberately calls the helpers annotated with RequiresUnreferencedCode; that is what it tests. No public API requires dynamic code, so IL3050 is not suppressed. -->
    <!-- MA0048: the fixture types and the program share one file; a single-file test program does not need one file per type. -->
    <!-- MA0008: the struct fixture is a plain data holder; layout and equality are irrelevant here. -->
    <!-- MA0051: the check table is one flat declarative list of rows; splitting it would only scatter it. -->
    <NoWarn>IL2026;MA0048;MA0008;MA0051</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UContractPackageVersion)' != ''">
    <!-- IL3050: the published 2.0.0 package's Old still carries RequiresDynamicCode; package mode compares against it. -->
    <NoWarn>$(NoWarn);IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(UContractPackageVersion)' == ''">
    <ProjectReference Include="..\..\src\uContract\uContract.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UContractPackageVersion)' != ''">
    <PackageReference Include="uContract" Version="$(UContractPackageVersion)" />
  </ItemGroup>

</Project>
