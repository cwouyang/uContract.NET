<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Assembly Information -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright (c) 2025-2026 uContract.NET Contributors</Copyright>

    <!-- Package Metadata -->
    <PackageId>uContract</PackageId>
    <Version>1.0.0</Version>
    <Authors>uContract.NET Contributors</Authors>
    <Company>uContract.NET</Company>
    <Product>uContract.NET</Product>
    <Description>Design by Contract library for .NET 8+. A direct port of the Java uContract library with .NET-specific improvements.

Features:
• Zero overhead when disabled (lazy evaluation)
• AsyncLocal support for async/await
• 17 contract methods (Require, Ensure, Invariant, Old, etc.)
• Zero external dependencies
• Full nullable reference type support
• Thread-safe with recursion guard
• Reflection-based field comparison (EnsureAssignable)
• JSON-based state capture (Old&lt;T&gt;)

Perfect for DDD aggregates, value objects, and domain services.</Description>
    <PackageTags>dbc;design-by-contract;contracts;ddd;domain-driven-design;invariants;preconditions;postconditions;dotnet;csharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cwouyang/uContract.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cwouyang/uContract.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/cwouyang/uContract.NET/blob/master/CHANGELOG.md for release notes.</PackageReleaseNotes>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\uContract.xml</DocumentationFile>

    <!-- Trimming and AOT -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Symbols and Debugging -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Build-time packages (not propagated to consumers).
       Source Link needs no PackageReference: the .NET 8+ SDK generates it in-box
       (ADR-0017 amendment 2026-07-03). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Public API tracking baseline (per ADR-0019) -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Include README, icon, and third-party notices in package -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
